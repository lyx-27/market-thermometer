# 市场温度计 / Market Thermometer — environment configuration
# Copy this file to ".env" or set these variables in your shell.

# CoinGecko demo API key (free tier).
# Get one at: https://www.coingecko.com/en/developers/dashboard
# Format: CG-xxxxxxxxxxxxxxxxxxxxxxxx
CG_DEMO_KEY=CG-your-demo-key-here

# Optional: route CoinGecko requests through a local HTTP proxy (e.g. Clash).
# Leave unset to connect directly. DefiLlama / Tencent / alternative.me always go direct.
# MARKET_PROXY=http://127.0.0.1:7897
